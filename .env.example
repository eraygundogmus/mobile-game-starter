# Copy to .env (git-ignored). Never commit real values.
# `npm run art:gen` and `npm run audio:gen` read this file.

# scripts/gen-audio.mjs (paid; only with --go)
ELEVENLABS_API_KEY=

# The API address the app calls (default http://localhost:8787).
# Expo reads .env files from the app folder, so put this line in apps/mobile/.env,
# or set it on the command line: EXPO_PUBLIC_API_BASE=http://<computer-ip>:8787 npm run mobile
# EXPO_PUBLIC_API_BASE=http://localhost:8787
